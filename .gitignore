flutter_mobile/build/

# Temporary crypto buffers and logs
.kromium_tmp_*
.kromium_dec_tmp_*
.kromium_txt_tmp_*
*.tmp
*.log

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
