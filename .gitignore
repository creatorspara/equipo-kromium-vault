__pycache__/
*.py[cod]
*$py.class

# PyInstaller build artifacts
build/
*.spec

# Distribution binaries (built & attached via GitHub Releases)
dist/

# Flutter / Dart build artifacts
flutter_mobile/.dart_tool/
